{
  "realm": "llm-dev-kit",
  "displayName": "LLM Dev Kit",
  "enabled": true,
  "sslRequired": "external",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": false,
  "bruteForceProtected": true,
  "roles": {
    "realm": [
      { "name": "admin", "description": "Everything, including clearing the index and the cache." },
      { "name": "user", "description": "Chat and add documents." },
      { "name": "viewer", "description": "Chat only." }
    ]
  },
  "defaultRole": {
    "name": "default-roles-llm-dev-kit",
    "composite": true,
    "composites": { "realm": ["offline_access", "uma_authorization", "user"] }
  },
  "clients": [
    {
      "clientId": "llm-dev-kit-web",
      "name": "LLM Dev Kit",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "${AUTH_KEYCLOAK_SECRET}",
      "redirectUris": ["${WEB_PUBLIC_URL}/api/auth/callback/keycloak"],
      "webOrigins": ["${WEB_PUBLIC_URL}"],
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "${WEB_PUBLIC_URL}/*"
      },
      "protocolMappers": [
        {
          "name": "audience: llm-dev-kit",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.custom.audience": "llm-dev-kit",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        }
      ]
    }
  ]
}
